# -- Jira Connection (required) --
# Glofox default (also in workspace.yaml). Override if using another instance.
JIRA_BASE_URL=https://abcfinancial.atlassian.net

# Jira account email address
JIRA_EMAIL=you@company.com

# Jira API token - generate at:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# -- Workspace (optional) --
# Active workspace folder name from workspaces/ directory.
# Leave empty or omit to use the root workspace.yaml.
# JIRA_TOOLKIT_WORKSPACE=

# -- MCP guided welcome defaults (one-time - set at welcome onboard) --
# Team + projects (required for ticket fetch)
DEFAULT_JIRA_TEAM=Glofox Insights Customize
DEFAULT_JIRA_TEAM_ID=317996a7-118a-4cf3-a3c6-04163516ed32
DEFAULT_PROJECTS=PIC,AN
DEFAULT_SELECTION_MODE=status
# Bound MCP program pack (glofox | ignite | etl). Never mix crews across packs.
RELEASE_PROGRAM=glofox
# 
# Team crew - one-time onboard (say "use glofox" ΓåÆ "crew done" or crew add for Ignite/ETL)
# Squad = in-squad dev team (ticket assignees mandatory on review calls)
# TEAM_CREW_SQUAD=Lakshmi Narasimha <lakshminarasimhanaidu.yalamarti@abcfitness.com>; Chanti Kumar Jakkula <chantikumar.jakkula@abcfitness.com>; Rekha; Mona; Navya; Nikhath; Bharathi
# TEAM_CREW_LEADERSHIP=Sushma Bhamidipati <VenkataSuryaNagaSushma.Bhamidipati@abcfitness.com>; Soumyakant Mishra <Soumyakant.Mishra@abcfitness.com>
# TEAM_CREW_QA=Akhil Sree Kumar, Nikhila Sree Ramisetti
# TEAM_CREW_OPTIONAL=Sai Anirudh
# TEAM_CREW_REVIEW=
# TEAM_CREW_RELEASE=
# TEAM_CREW_EXCLUDE=erasmo.garcia@abcfitness.com,gabriel.barbosa@abcfitness.com

# -- GitHub PR gate (optional - Release Orchestrator Step 3) --
# Token with repo read access to gf-insights-fitnessbi + customize repos.
# GITHUB_TOKEN=
# GH_TOKEN=

# -- Release Notes Generator (optional) --
# Directory for generated release notes .docx files (defaults to system temp)
# RELEASE_NOTES_OUTPUT_DIR=

# Path to the reference .docx template used for release notes generation
# RELEASE_NOTES_REFERENCE_DOC=

# -- TCKT Request Type Auto-Set (optional) --
# When both IDs are set, the app auto-assigns the Service Desk request type
# after TCKT creation. You can configure these in EITHER place:
# 1. Settings ΓåÆ Service Desk tab (writes workspace.yaml) - recommended
# 2. Here in .env (overrides workspace.yaml when set)
# If missing, Service Ticket still works - set Request Type manually in Jira portal.
# TCKT_SERVICE_DESK_ID=
# TCKT_REQUEST_TYPE_ID=

# -- Confluence Release-Notes Companion (optional) --
# Enables the "Confluence Page" tab after ticket creation. When unset the
# tab falls back to a dry-run preview only (no publish).
# CONFLUENCE_URL=https://yourorg.atlassian.net
# CONFLUENCE_TOKEN=your-api-token-here
# CONFLUENCE_SPACE=REL
# CONFLUENCE_PARENT_ID=

# -- Daily Review Agent (merged - same repo as Release Orchestrator) --
# Config: daily_review_agent/agent.yaml ┬╖ Setup: .\scripts\setup_e2e.ps1
# RELEASE_ORCHESTRATOR_ROOT=   # optional; defaults to repo root
# TEAMS_MCP_ROOT=              # optional; defaults to release_mcp/scripts/daily_review
# TEAMS_MCP_PROJECT=           # optional; path to sibling teams-mcp project
# NODE_EXE=                    # optional; path to node.exe for Playwright scripts
# CURSOR_MCP_CONFIG=           # optional; override ~/.cursor/mcp.json path

# -- Browser automation (SharePoint + Slack via Cursor MCP) --
# No extra env vars required. Enable Playwright MCP + Slack MCP in Cursor Settings.
# Run: python scripts/browser_automation_setup.py
# Optional Slack deep links for Playwright fallback:
# SLACK_TEAM_ID=T00000000

# -- Slack announce --
# **Cursor Slack MCP (default):** Step 6 - NO token needed.
# **Playwright fallback:** say "send slack playwright" in wizard.
# **Platform auto-send (optional):** set SLACK_BOT_TOKEN for Streamlit UI only.
# Channels/CC in workspace.yaml ΓåÆ slack_announce.
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# Daily Review Agent slack: chat:write (+ chat:scheduleMessage if schedule_reminder)
# Optional: SLACK_TEAM_ID=TΓÇª (auto-resolved via auth.test if omitted)
# 
# LEGACY / DEPRECATED - incoming webhooks used only by notifier.py when
# explicitly called. They do NOT power the Service Ticket / MCP Slack step.
# Do not set these expecting them to replace SLACK_BOT_TOKEN + slack_announce.
# SLACK_DEPLOY_WEBHOOK=https://hooks.slack.com/services/T000/B000/xxx
# TEAMS_DEPLOY_WEBHOOK=https://outlook.office.com/webhook/...
# DEPLOY_NOTIFY_FOOTER=Additional markdown-formatted footer for Slack

# -- Microsoft Graph (SharePoint upload + Teams schedule) --
# Backend wired in Ticket Review + Service Ticket + MCP. Targets in workspace.yaml.
# sharepoint_upload_* and teams_schedule_*. Keep unset until the Entra app
# is provisioned. Targets live in workspace.yaml ΓåÆ sharepoint_upload /
# teams_schedule (leave enabled: false until ready).
# Required Graph app permissions (application):
# Sites.ReadWrite.All (or Files.ReadWrite.All) - SharePoint upload
# Calendars.ReadWrite - Teams meeting create on organizer mailbox
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# One-time delegated token (Graph Explorer) - expires ~1h; prefer app creds above:
# MS_GRAPH_ACCESS_TOKEN=
# Aliases also accepted: MICROSOFT_TENANT_ID / MICROSOFT_CLIENT_ID /
# MICROSOFT_CLIENT_SECRET
# 
# Optional sample SharePoint URL for scripts/verify_integrations.py --check=sharepoint
# SHAREPOINT_SAMPLE_URL=https://abcfinancial.sharepoint.com/.../Release%20Notes.docx

# -- AI Enhancement (optional) --
# When set the AI summarizer and acceptance-criteria generator use OpenAI.
# Falls back to deterministic heuristics when unset.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# -- Templates & Audit (safe defaults) --
JRT_TEMPLATES_DIR=~/.jira-release-tool/templates
JRT_AUDIT_LOG=~/.jira-release-tool/audit/request-type.log

# -- Logging --
# Set to 'json' for structured log output suitable for aggregators.
LOG_FORMAT=text
LOG_LEVEL=INFO

# -- Jira API efficiency (optional) --
# Pause (seconds) between successive Jira HTTP calls. Default 0 (off).
# Under persistent HTTP 429 rate limits, try 0.5.
# JIRA_RATE_LIMIT_PAUSE=0
# 
# TTL (seconds) for read-only project version metadata cache. Default 300.
# Set 0 to disable. Cleared automatically after mark-released.
# JIRA_VERSION_CACHE_TTL=300
# 
# Bounded concurrency for read-only preflight only (comment checks, ticket
# counts). Writes always stay sequential. Default 1; safe range 1ΓÇô8.
# JIRA_READONLY_CONCURRENCY=1

# -- Docker / Streamlit (safe defaults) --
# Max file upload size in MB (used by docker-compose)
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=10
