              "type": "text",
              "text": "Summary"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Fix duplicate ABC processing fee processing in "
            },
            {
              "type": "text",
              "text": "[dw].[Get_Drdr_Dmb]",
              "marks": [
                {
                  "type": "code"
                }
              ]
            },
            {
              "type": "text",
              "text": " so Insights DRDR no longer overstates Club Account Deductions."
