          ],
          "attrs": {
            "localId": "221fdf27009f"
          }
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "for ticket: "
            },
            {
              "type": "inlineCard",
              "attrs": {
