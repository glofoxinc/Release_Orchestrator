        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Before/after change:"
            }
          ],
          "attrs": {
            "localId": "ba4025b6680a"
          }
        },
        {
          "type": "codeBlock",
          "attrs": {
            "language": "sql",
            "localId": "2f7465311137"
          },
          "content": [
            {
              "type": "text",
              "text": "BEFORE:  \n    left join #tmpmtd b  \n        on a.club_number_i = b.club_number_i  \n       and d.the_date       = b.db_date  \n\nAFTER:  \n    left join #tmpmtd b  \n        on a.club_number_i = b.club_number_i  \n       and d.the_date       = b.db_date  \n       and (  \n            b.db_description <> 'Less ABC Fees'  \n            or not exists (  \n                select 1  \n                from DW.daily_deduction_reimbrsmnt_vw ddrv  \n                where ddrv.club_number_i = a.club_number_i  \n                  and ddrv.ctndte_date   = d.the_date  \n                  and ddrv.amount_type   = 'Club Account'  \n                  and trim(lower(ddrv.amount_description)) in ('processing fee','processing fees')  \n            )  \n       )"
            }
          ]
        },
