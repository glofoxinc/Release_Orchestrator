    "glofoxinc/release-orchestrator",
    "LyNarasimha/Demo_repo"
  ],
  "routingRules": [
    "project AN (Glofox Analytics) → default glofoxinc/gf-insights-fitnessbi unless summary is clearly Fabric/lakehouse/gold layer/notebook → glofoxinc/gf-fabric-fitnessbi",
    "project PIC (Customize BI) → match client/brand in summary (Jetts, Lift, Xtreme Fitness, …) → glofoxinc/abc-customize-* repo",
    "Explicit github.com/glofoxinc/... in ticket overrides heuristics",
    "Club Pilates/XPO tickets map to abc-customize-insights-xpo",
    "F45 SK / FS8 SK map to abc-customize-f45-SK and abc-customize-insights-FS8-SouthKorea respectively"
